# ==============================================================================
# VulnEye Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' for local development or configure these variables
# in your cloud deployment platform (Vercel, Render, AWS, etc.).

# ------------------------------------------------------------------------------
# 1. REQUIRED IN PRODUCTION
# ------------------------------------------------------------------------------
# A cryptographically random secret key used to sign session cookies and tokens.
# Generate a new 256-bit key with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY="replace_with_a_secure_random_256bit_hex_token"

# ------------------------------------------------------------------------------
# 2. DATABASE PERSISTENCE
# ------------------------------------------------------------------------------
# Local Development (Default):
DATABASE_URL="sqlite:///scans.db"

# Production PostgreSQL (Required on Vercel/Serverless for persistent storage):
# Compatible with Neon, Supabase, Render PostgreSQL, AWS RDS, etc.
# Note: Both 'postgres://' and 'postgresql://' URL schemes are automatically supported.
# DATABASE_URL="postgresql://username:password@ep-cool-server.region.aws.neon.tech/vulneye_db?sslmode=require"

# ------------------------------------------------------------------------------
# 3. GOOGLE OAUTH 2.0 (OPTIONAL)
# ------------------------------------------------------------------------------
# Enables Google Single Sign-On (SSO). If omitted, the platform runs in Demo/Guest mode.
GOOGLE_CLIENT_ID="your_google_client_id_here.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret_here"

# ------------------------------------------------------------------------------
# 4. ENVIRONMENT MODE
# ------------------------------------------------------------------------------
# Set to 'development' for local work, or 'production' for live deployments.
FLASK_ENV="development"
