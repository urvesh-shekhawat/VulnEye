# VulnEye Local Environment Configuration Example
# Copy this file to '.env' and fill in your real Google Credentials

# A secure secret key for signing Flask sessions
SECRET_KEY="supersecretkey123_replace_in_production"

# Your Google OAuth 2.0 Credentials (from Google Cloud Console)
GOOGLE_CLIENT_ID="your_google_client_id_here.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret_here"
